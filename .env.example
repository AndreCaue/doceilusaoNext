# ─────────────────────────────────────────────────────────────────────────────
# Doce Ilusão — Next.js app environment contract (.env.example)
#
# This file is COMMIT-SAFE: it documents variable names and usage ONLY.
# All values are blank or safe development defaults — there are NO real
# secrets in this file. NEVER commit real values (secrets, tokens,
# certificates, keys) to any tracked file.
#
# Where real secrets live:
#   - Local development:   doceilusao-next/.env.local  (gitignored, CLI-only)
#   - Deployment:          Vercel project env vars     (dashboard/CLI only)
#
# Conventions:
#   - Server-only variables MUST NOT be prefixed with NEXT_PUBLIC_ —
#     anything prefixed NEXT_PUBLIC_ is inlined into the client bundle
#     and exposed to every visitor.
#   - Owner phase = the Phase 25+ plan that introduces/consumes the var.
#
# Mirror of the backend inventory: Backend/app/core/config.py
# Conformance references: 25-CONTEXT.md decisions D-10, D-13, D-14, D-15
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (Phase 25 / FOUND-02) ──────────────────────────────────────────
# Neon pooled endpoint — used by Prisma at RUNTIME (PgBouncer-compatible).
# Already present in doceilusao-next/.env; documented here for usage contract.
DATABASE_URL=

# Neon DIRECT endpoint — used by Prisma for MIGRATIONS/DDL only (not pooled).
DIRECT_URL=

# ─── Backend proxy (Phase 25, decision D-10) ─────────────────────────────────
# Target FastAPI backend for the strangler-fig catch-all proxy.
# SERVER-ONLY — NEVER rename to NEXT_PUBLIC_BACKEND_URL (would leak the
# internal backend address to the client bundle and bypass the proxy).
# Safe dev default: local FastAPI on :8000.
BACKEND_URL=http://localhost:8000

# ─── Auth (Phase 26) ─────────────────────────────────────────────────────────
# Shared HS256 signing key for the Python↔Next.js JWT flow (must match the
# backend SECRET_KEY during coexistence). SERVER-ONLY. 32+ random bytes.
SECRET_KEY=

# Optional alias read by admin-proxy.ts when present (Phase 27 admin routes).
# SERVER-ONLY.
AUTH_SECRET=

# ─── Email delivery (Phase 26, D-10) ──────────────────────────────────────────
# Verification + password-reset emails are sent DIRECTLY from Next.js (no Python
# proxy). Resend REST API in production (RESEND_API_KEY), SMTP (nodemailer) in
# development — same provider + templates as Backend/app/auth/email_service.py.
# SERVER-ONLY — never NEXT_PUBLIC_-prefixed.
RESEND_API_KEY=

# SMTP relay for development email (mirrors smtplib params, email_service.py:72-75).
# Safe dev defaults: smtp.gmail.com:587 (App Password, not the normal password).
SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_USER=

SMTP_PASS=

# Optional dev from-address override (default: Doce Ilusão <mcd.magica.cartas@doceilusao.store>)
FROM_EMAIL_DEV=

# ─── Efí PIX / payments (Phase 25 cert pipeline, D-13/D-14/D-15, Phase 29) ──
# SERVER-ONLY — none of these may be NEXT_PUBLIC_-prefixed.
EFI_CLIENT_ID=

EFI_CLIENT_SECRET=

# Base64 of the .p12 mTLS certificate (e.g. openssl base64 -in cert.p12).
# SERVER-ONLY — never log this value; keep it out of client bundles.
# The https.Agent singleton decodes it at server startup (D-13).
EFI_CERTIFICATE_BASE64=

# Certificate passphrase — stored in a SEPARATE env var from the certificate
# itself (D-14). SERVER-ONLY.
EFI_CERT_PASSPHRASE=

# Sandbox toggle — boolean string parse ("true" / "1" = sandbox).
# Safe dev default: sandbox.
EFI_SANDBOX=true

# Efí tokenização no browser (payment-token-efi — D-20/D-21).
# PUBLIC by design (NEXT_PUBLIC_ prefix): the browser tokenization SDK needs
# these to tokenize card data WITHOUT a server round-trip (card-flow parity,
# Frontend CardPayment.tsx). They mirror VITE_EFI_ACCOUNTID / VITE_ENVIRONMENT
# and leak NO secrets — client_id/secret/cert stay server-only (T-25-03).
NEXT_PUBLIC_EFI_ACCOUNTID=

NEXT_PUBLIC_EFI_ENVIRONMENT=

# ─── Melhor Envio (Phase 29/31) ──────────────────────────────────────────────
# OAuth client credentials + stored access token (see Backend config.py).
# SERVER-ONLY.
MELHOR_ENVIO_CLIENT_ID=

MELHOR_ENVIO_CLIENT_SECRET=

MELHOR_ENVIO_TOKEN=

# ─── S3 storage (Phase 28+) ──────────────────────────────────────────────────
# Credentials for private content + public product images (sa-east-1).
# SERVER-ONLY — AWS_SECRET_ACCESS_KEY in particular must never be public.
AWS_ACCESS_KEY_ID=

AWS_SECRET_ACCESS_KEY=

AWS_REGION=sa-east-1

# Bucket names per environment (mirror of Backend config.py dev/prod pairs).
S3_BUCKET_PUBLIC_DEV=

S3_BUCKET_PUBLIC_PROD=

S3_BUCKET_PRIVATE_DEV=

S3_BUCKET_PRIVATE_PROD=

# ─── Webhooks (Phase 29, D-11/D-12/D-21) ────────────────────────────────────
# Validation secret for incoming Efí webhooks. FAIL-CLOSED (D-12): a request
# without a matching ?webhook_token=<WEBHOOK_SECRET> query param is answered
# 401 before any body/Efí processing. SERVER-ONLY — never log it.
WEBHOOK_SECRET=

# Public HTTPS base where the Next.js payment receiver is reachable. Efí is
# no longer pointed at FastAPI — per-charge notification_url is composed as
# {WEBHOOK_URL}/payment/webhook/efipay?webhook_token=... + pix receiver at
# {WEBHOOK_URL}/payment/webhook/pix (D-11; see card.ts buildNotificationUrl).
WEBHOOK_URL=

# ngrok tunnel URL used for local webhook testing (dev only). SERVER-ONLY.
NGROK_URL=

# ─── Store identity (mirror of Backend config.py) ─────────────────────────────
# Static store metadata used by catalog/order flows. SERVER-ONLY (no client
# secrets here, but they are consumed server-side only).
STORE_NAME=

STORE_PHONE=

STORE_EMAIL=

STORE_DOCUMENT=

STORE_POSTAL_CODE=

STORE_STREET=

STORE_NUMBER=

STORE_NEIGHBORHOOD=

STORE_CITY=

STORE_STATE=

# ─── PIX ─────────────────────────────────────────────────────────────────────
# Merchant PIX key (e.g. CNPJ/CPF/email chave) used for QR-code charges.
# SERVER-ONLY.
PIX_KEY=